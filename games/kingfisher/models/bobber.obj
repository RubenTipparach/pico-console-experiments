# The bobber: a small octahedron, red cap over a white belly, counter
# clockwise winding viewed from outside.

mtllib bobber.mtl

v  0.00  0.50  0.00
v  0.35  0.00  0.00
v  0.00  0.00  0.35
v -0.35  0.00  0.00
v  0.00  0.00 -0.35
v  0.00 -0.50  0.00

usemtl bobber_top
f 1 2 3
f 1 3 4
f 1 4 5
f 1 5 2

usemtl bobber_belly
f 6 3 2
f 6 4 3
f 6 5 4
f 6 2 5
