# The player's punt. +z is the bow, +y up, counter clockwise winding viewed
# from outside.

mtllib boat.mtl

# hull bottom
v -0.50 0.00 -1.00
v  0.50 0.00 -1.00
v  0.50 0.00  1.00
v -0.50 0.00  1.00
# gunwale
v -0.65 0.40 -1.25
v  0.65 0.40 -1.25
v  0.70 0.40  1.35
v -0.70 0.40  1.35

usemtl boat_hull
# bottom
f 1 3 2
f 1 4 3
# bow
f 7 4 8
f 7 3 4
# stern
f 5 2 6
f 5 1 2
# starboard
f 6 3 7
f 6 2 3
# port
f 8 1 5
f 8 4 1

usemtl boat_deck
# deck
f 5 7 8
f 5 6 7
