# Tom Lander landing pad.
# Authored at true world units: 7.0 half width, 2.4 tall, so it
# draws at scale 1.0 and tests/preview.cpp checks those extents
# against k_pad_half and k_pad_rise.
mtllib pad.mtl
o pad
v -7.000000 2.400000 -7.000000
v -2.333333 2.400000 -7.000000
v 2.333333 2.400000 -7.000000
v 7.000000 2.400000 -7.000000
v -7.000000 2.400000 -2.333333
v -2.333333 2.400000 -2.333333
v 2.333333 2.400000 -2.333333
v 7.000000 2.400000 -2.333333
v -7.000000 2.400000 2.333333
v -2.333333 2.400000 2.333333
v 2.333333 2.400000 2.333333
v 7.000000 2.400000 2.333333
v -7.000000 2.400000 7.000000
v -2.333333 2.400000 7.000000
v 2.333333 2.400000 7.000000
v 7.000000 2.400000 7.000000
v -7.000000 0.000000 -7.000000
v 7.000000 0.000000 -7.000000
v 7.000000 0.000000 7.000000
v -7.000000 0.000000 7.000000
usemtl deck00
f 1 2 6 5
usemtl deck01
f 2 3 7 6
usemtl deck02
f 3 4 8 7
usemtl deck03
f 5 6 10 9
