# Enemy bomber. Nose at +Z, 1.0 long.
#
# Deep and slab sided where the fighter is thin, because the two have to be
# told apart at fifteen pixels and colour alone will not do it: a bomber that
# reads as a fighter is a bomber nobody breaks off to intercept.

mtllib bomber.mtl

# ---- hull: a deep slab, barely tapered
usemtl hull
v  -0.140  -0.110  -0.500
v   0.140  -0.110  -0.500
v   0.140   0.110  -0.500
v  -0.140   0.110  -0.500
v  -0.090  -0.075   0.500
v   0.090  -0.075   0.500
v   0.090   0.075   0.500
v  -0.090   0.075   0.500
f -8 -7 -6 -5
f -4 -1 -2 -3
f -7 -3 -2 -6
f -8 -5 -1 -4
f -5 -6 -2 -1
f -8 -4 -3 -7

# ---- dorsal spine
usemtl spine
v  -0.070   0.105  -0.360
v   0.070   0.105  -0.360
v   0.070   0.180  -0.360
v  -0.070   0.180  -0.360
v  -0.050   0.072   0.150
v   0.050   0.072   0.150
v   0.050   0.130   0.150
v  -0.050   0.130   0.150
f -8 -7 -6 -5
f -4 -1 -2 -3
f -7 -3 -2 -6
f -8 -5 -1 -4
f -5 -6 -2 -1
f -8 -4 -3 -7

# ---- left torpedo pod, slung under a stub wing
usemtl pod
v  -0.330  -0.075  -0.320
v  -0.135  -0.100  -0.360
v  -0.135   0.040  -0.360
v  -0.330   0.010  -0.320
v  -0.330  -0.075   0.170
v  -0.135  -0.100   0.230
v  -0.135   0.040   0.230
v  -0.330   0.010   0.170
f -8 -7 -6 -5
f -4 -1 -2 -3
f -7 -3 -2 -6
f -8 -5 -1 -4
f -5 -6 -2 -1
f -8 -4 -3 -7

# ---- right torpedo pod
usemtl pod
v   0.135  -0.100  -0.360
v   0.330  -0.075  -0.320
v   0.330   0.010  -0.320
v   0.135   0.040  -0.360
v   0.135  -0.100   0.230
v   0.330  -0.075   0.170
v   0.330   0.010   0.170
v   0.135   0.040   0.230
f -8 -7 -6 -5
f -4 -1 -2 -3
f -7 -3 -2 -6
f -8 -5 -1 -4
f -5 -6 -2 -1
f -8 -4 -3 -7
