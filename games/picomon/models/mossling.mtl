# Colours for mossling.obj.
#
# Every channel is a multiple of 0x11, because the panel is four bits per
# channel and a colour that is not shifts on the device and nowhere else.
# Each Kd is a sixteenth, so obj2cpp's round(v * 255) lands back exactly
# on the byte it was written for.

# hide
newmtl mossling_body
Kd 0.333333 0.666667 0.333333   # #55AA55

# chest blaze and underside
newmtl mossling_belly
Kd 0.800000 0.933333 0.600000   # #CCEE99

newmtl mossling_stem
Kd 0.400000 0.600000 0.266667   # #669944

# the sprout, and the whole silhouette
newmtl mossling_leaf
Kd 0.533333 0.866667 0.333333   # #88DD55

newmtl mossling_leaf2
Kd 0.400000 0.733333 0.266667   # #66BB44

newmtl mossling_leg
Kd 0.266667 0.600000 0.266667   # #449944
