# Colours for sparklet.obj, generated with the model.
#
# Every channel is a multiple of 0x11, because the panel is four bits per
# channel and a colour that is not shifts on the device and nowhere else.
# Each Kd is a sixteenth, so obj2cpp's round(v * 255) lands back exactly
# on the byte it was written for.

newmtl c111122
Kd 0.066667 0.066667 0.133333   # #111122

newmtl cBB9922
Kd 0.733333 0.600000 0.133333   # #BB9922

newmtl cBBAA44
Kd 0.733333 0.666667 0.266667   # #BBAA44

newmtl cDDBB33
Kd 0.866667 0.733333 0.200000   # #DDBB33

newmtl cDDBB44
Kd 0.866667 0.733333 0.266667   # #DDBB44

newmtl cEECC44
Kd 0.933333 0.800000 0.266667   # #EECC44

newmtl cEECC66
Kd 0.933333 0.800000 0.400000   # #EECC66

newmtl cEEDD66
Kd 0.933333 0.866667 0.400000   # #EEDD66

newmtl cFFDD99
Kd 1.000000 0.866667 0.600000   # #FFDD99

newmtl cFFEE66
Kd 1.000000 0.933333 0.400000   # #FFEE66

newmtl cFFEE99
Kd 1.000000 0.933333 0.600000   # #FFEE99
