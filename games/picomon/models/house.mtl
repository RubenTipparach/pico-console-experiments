# Colours for house.obj. Every channel is a multiple of
# 0x11, because the panel is four bits per channel and anything else
# shifts on the device and nowhere else.

newmtl house_wall
Kd 0.933333 0.866667 0.733333   # #EEDDBB

newmtl house_roof
Kd 0.800000 0.266667 0.266667   # #CC4444

newmtl house_door
Kd 0.466667 0.266667 0.200000   # #774433

newmtl house_glass
Kd 0.533333 0.733333 0.866667   # #88BBDD
