# Collectible gem: an octahedron, 8 triangles.
#
# Edit this in Blender or any modeller and rebuild. tools/obj2cpp.py turns it
# into a const table in flash at compile time, so nothing here costs RAM.
# Colours come from gem.mtl and are tinted per gem type at draw time.

mtllib gem.mtl

v  0.000  0.900  0.000
v  0.500  0.000  0.000
v  0.000  0.000  0.500
v -0.500  0.000  0.000
v  0.000  0.000 -0.500
v  0.000 -0.700  0.000

usemtl gem_body

f 1 2 3
f 1 3 4
f 1 4 5
f 1 5 2
f 6 3 2
f 6 4 3
f 6 5 4
f 6 2 5
