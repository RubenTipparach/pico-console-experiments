# The player's fighter. Nose at +Z, 1.0 long, drawn at hull_length(Fighter).
#
# Five blocks: a tapered fuselage, a canopy, two swept wings and a pair of
# engine pods. See README.md for the block template and the winding rule.

mtllib interceptor.mtl

# ---- fuselage: wide and flat at the tail, drawn down to a point at the nose
usemtl hull
v  -0.090  -0.060  -0.420
v   0.090  -0.060  -0.420
v   0.090   0.070  -0.420
v  -0.090   0.070  -0.420
v  -0.025  -0.020   0.500
v   0.025  -0.020   0.500
v   0.025   0.020   0.500
v  -0.025   0.020   0.500
f -8 -7 -6 -5
f -4 -1 -2 -3
f -7 -3 -2 -6
f -8 -5 -1 -4
f -5 -6 -2 -1
f -8 -4 -3 -7

# ---- canopy
usemtl canopy
v  -0.058   0.060   0.000
v   0.058   0.060   0.000
v   0.058   0.140   0.000
v  -0.058   0.140   0.000
v  -0.034   0.055   0.250
v   0.034   0.055   0.250
v   0.034   0.092   0.250
v  -0.034   0.092   0.250
f -8 -7 -6 -5
f -4 -1 -2 -3
f -7 -3 -2 -6
f -8 -5 -1 -4
f -5 -6 -2 -1
f -8 -4 -3 -7

# ---- left wing. Tip is the low x corner, root the high x corner, so the
# block keeps the standard ordering and is not a mirrored solid.
usemtl wing
v  -0.400  -0.012  -0.340
v  -0.080  -0.020  -0.360
v  -0.080   0.020  -0.360
v  -0.400   0.012  -0.340
v  -0.400  -0.012  -0.100
v  -0.080  -0.020   0.070
v  -0.080   0.020   0.070
v  -0.400   0.012  -0.100
f -8 -7 -6 -5
f -4 -1 -2 -3
f -7 -3 -2 -6
f -8 -5 -1 -4
f -5 -6 -2 -1
f -8 -4 -3 -7

# ---- right wing
usemtl wing
v   0.080  -0.020  -0.360
v   0.400  -0.012  -0.340
v   0.400   0.012  -0.340
v   0.080   0.020  -0.360
v   0.080  -0.020   0.070
v   0.400  -0.012  -0.100
v   0.400   0.012  -0.100
v   0.080   0.020   0.070
f -8 -7 -6 -5
f -4 -1 -2 -3
f -7 -3 -2 -6
f -8 -5 -1 -4
f -5 -6 -2 -1
f -8 -4 -3 -7

# ---- left engine pod
usemtl engine
v  -0.215  -0.050  -0.500
v  -0.100  -0.050  -0.500
v  -0.100   0.050  -0.500
v  -0.215   0.050  -0.500
v  -0.200  -0.045  -0.150
v  -0.105  -0.045  -0.150
v  -0.105   0.045  -0.150
v  -0.200   0.045  -0.150
f -8 -7 -6 -5
f -4 -1 -2 -3
f -7 -3 -2 -6
f -8 -5 -1 -4
f -5 -6 -2 -1
f -8 -4 -3 -7

